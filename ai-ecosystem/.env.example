# EdVisingU AI Ecosystem — master environment file (Masterbuild §21.9)
# Copy to .env on the VPS at /opt/edvisingu/.env and fill in values from Bitwarden.
# NEVER commit the real .env (§14.1). Rotate any key that leaks (§14.2).

# --- AI model providers (router only — agents never see these) ---
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=            # for hermes-builder (GPT-4o code tasks, §26.1)
GOOGLE_AI_API_KEY=         # Gemini, from aistudio.google.com

# --- Model IDs (override without code changes) ---
MODEL_DEFAULT=claude-sonnet-4-6
MODEL_HAIKU=claude-haiku-4-5-20251001
MODEL_GEMINI=gemini-2.0-flash
MODEL_CODEX=gpt-4o

# --- Supabase (EXISTING project — never create a new one, §8.1) ---
SUPABASE_URL=https://bvxhicdnaordolguuyal.supabase.co
SUPABASE_KEY=              # service_role key from Settings > API, via Bitwarden

# --- Agent tools (§23) ---
TAVILY_API_KEY=
NOTION_TOKEN=
STRIPE_SECRET_KEY=
GITHUB_TOKEN=

# --- Infrastructure (in-cluster addresses; defaults match docker-compose) ---
REDIS_URL=redis://redis:6379
CHROMA_HOST=chromadb
CHROMA_PORT=8000
N8N_BASE_URL=http://n8n:5678
ROUTER_URL=http://fastapi-router:8000

# --- Router internals (this repo's additions — see docs/ERRATA.md) ---
ROUTER_INTERNAL_TOKEN=     # shared secret for /internal/complete; generate: python3 -c "import secrets; print(secrets.token_hex(32))"
FAKE_LLM=0                 # 1 = router returns canned replies (keyless smoke tests only)
DATA_ROOT=/srv             # host root for agent data volumes; override for local/CI runs

# --- n8n ---
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# --- Open WebUI ---
WEBUI_SECRET_KEY=          # 32-char random string

# --- Messaging / community ---
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
WHOP_API_KEY=

# --- Content creation ---
HEYGEN_API_KEY=
ELEVENLABS_API_KEY=

# --- Google Workspace (§28) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- Email and messaging platforms (§29) ---
MAILERLITE_API_KEY=
MANYCHAT_API_KEY=

# --- Social and content platforms (§29) ---
BLOTATO_API_KEY=
HIGGSFIELD_API_KEY=

# --- Business platforms ---
DISCO_API_KEY=
SKOOL_API_KEY=

# --- DrDDurham campaign (§30) ---
DRDDURHAM_FB_PAGE_ID=
DRDDURHAM_FB_ACCESS_TOKEN=

# --- Storefronts (agents 11-25, future) ---
GUMROAD_API_KEY=
PINTEREST_ACCESS_TOKEN=
